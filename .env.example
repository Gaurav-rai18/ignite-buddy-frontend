# ==============================================================================
# Ignite Buddy - Unified Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the project root and adjust variables for your setup.
# In production, already-exported environment variables in the process/shell will
# always take precedence over values defined in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CENTRAL SERVER & DJANGO SETTINGS
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing, session management, and CSRF protection.
# For production, generate a secure random 50+ character string.
DJANGO_SECRET_KEY=ignite-buddy-dev-secret-key-change-in-production-32chars-min!!

# Enable debug mode. Set to False / 0 in production to prevent leaking sensitive tracebacks.
# Values: 1 / True / true / yes / 0 / False / false / no
DJANGO_DEBUG=1
ASSISTANT_DEBUG=1

# Host network interface to bind the Daphne ASGI server.
# Use 127.0.0.1 for local dev or 0.0.0.0 to accept connections from campus network.
ASSISTANT_HOST=127.0.0.1

# Central server listening port.
ASSISTANT_PORT=8765

# Comma-separated list of allowed hostnames/IPs for HTTP requests and WebSocket connections.
# In development, '*' or '127.0.0.1,localhost' is typical.
ASSISTANT_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production CORS & CSRF Allowed Origins (comma-separated URLs)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Production HTTPS / Cookie Security (Set to True in production with SSL certificates)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Server timezone in IANA format (used for schedules, timetables, and notification timestamps).
ASSISTANT_TIMEZONE=Asia/Kolkata

# Directory where local server data (SQLite databases, media uploads, knowledge chunks) is stored.
# Defaults to data/ inside the project root or ~/.trainee_assistant_server.
ASSISTANT_DATA=data

# Thread pool capacity for executing synchronous commands and background tasks.
ASSISTANT_WORKER_THREADS=64

# Maximum seconds allowed for client device execution response before timing out.
ASSISTANT_DEVICE_TIMEOUT=900.0

# Maximum seconds allowed for WebSocket handshake authentication.
ASSISTANT_AUTH_TIMEOUT=5.0


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (DUAL SUPPORT: SQLITE / POSTGRESQL)
# ------------------------------------------------------------------------------
# By default, when DATABASE_URL is empty or commented out, Ignite Buddy automatically
# uses a lightweight, zero-configuration local SQLite database at:
# data/ignite_buddy.sqlite3
#
# To connect to production PostgreSQL, uncomment and configure DATABASE_URL:
# DATABASE_URL=postgresql://postgres:root@localhost:5432/ignite_buddy_db

# Alternative discrete PostgreSQL configuration variables (used if DJANGO_DB_ENGINE=postgresql):
# DJANGO_DB_ENGINE=postgresql
# POSTGRES_DB=ignite_buddy_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=root
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432


# ------------------------------------------------------------------------------
# 3. REAL-TIME CHANNELS & REDIS (SCALING)
# ------------------------------------------------------------------------------
# Channels layer configuration for WebSockets and broadcast push delivery.
# In single-process development, leave empty to use Channels InMemoryChannelLayer.
# For multi-worker production deployments across lab nodes, provide a Redis URL:
# REDIS_URL=redis://localhost:6379/0
# ASSISTANT_REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------------------------
# 4. AUTHENTICATION, RBAC & TOKENS
# ------------------------------------------------------------------------------
# Secret key used to sign and verify trainee desktop JWT authentication tokens.
# If left empty in DEBUG mode, a secure ephemeral token is generated automatically.
ASSISTANT_JWT_SECRET=change-me-to-a-very-long-secret-key-for-jwt-signing

# Lifetime of trainee desktop JWT tokens in hours (default: 168 hours = 7 days).
ASSISTANT_JWT_TTL_HOURS=168

# Secret token for administrative REST/CLI operations and automated diagnostics.
ASSISTANT_ADMIN_TOKEN=change-me-admin-secret

# Legacy static tokens for rapid development/testing without running full login:
# Single token for quick client auth:
# ASSISTANT_TOKEN=dev-token
# Multi-token mapping in "token:username,token:username" format:
# ASSISTANT_TOKENS=tokA:alice,tokB:bob


# ------------------------------------------------------------------------------
# 5. LLM GATEWAY (OLLAMA / CORPORATE MODEL HOST)
# ------------------------------------------------------------------------------
# Base URL of the Ollama server or compatible LLM gateway.
OLLAMA_BASE_URL=http://localhost:11434

# Primary conversational model used for RAG-augmented policy answering and explanations.
# Recommended: qwen2.5:7b, gpt-oss:20b, or qwen3.5:9b
CHAT_MODEL=qwen3.5:9b

# Fast, lightweight model for intent classification, query rewriting, and grammar parsing.
# Recommended: qwen2.5:3b or qwen2.5-coder:3b
FAST_MODEL=qwen2.5-coder:3b

# Embedding model used to vectorize RAG knowledge documents and trainee policy queries.
# Recommended: nomic-embed-text or embeddinggemma:latest
EMBED_MODEL=nomic-embed-text

# Optional vision model for multimodal screen inspection (if screen analysis is enabled).
# VISION_MODEL=llava:7b

# Optional API key for gated corporate LLM gateways.
# OLLAMA_API_KEY=your-api-key-here
# OLLAMA_AUTH_HEADER=Authorization

# Timeouts in seconds for LLM generation and connection.
OLLAMA_TIMEOUT=600.0
OLLAMA_CONNECT_TIMEOUT=10.0

# Context window sizes (tokens) passed to Ollama.
NUM_CTX_CHAT=131072
NUM_CTX_PLANNER=4096

# Number of past conversation turns hydrated from SQLite memory into the RAG prompt.
RAG_MEMORY_TURNS=15


# ------------------------------------------------------------------------------
# 6. CORPORATE PROXY & TLS (ZSCALER / ACCESSIBILITY)
# ------------------------------------------------------------------------------
# Configure outbound HTTP/HTTPS proxy for reaching external models or Google STT.
# Values: 'none' (direct), 'env' (honour HTTP_PROXY/HTTPS_PROXY), or explicit proxy URL:
# OLLAMA_PROXY=none
# OLLAMA_PROXY=http://proxy.corp.com:8080

# When working behind corporate SSL inspection proxies like Zscaler:
# Set to 1 to trust Windows OS Certificate Store (requires 'truststore' package).
OLLAMA_USE_SYSTEM_CERTS=0

# Path to custom corporate CA root bundle PEM file.
# OLLAMA_CA_BUNDLE=C:\certs\zscaler_root.pem

# Set to 0 to disable SSL verification (development/testing only).
OLLAMA_VERIFY_SSL=1


# ------------------------------------------------------------------------------
# 7. SPEECH-TO-TEXT (SERVER-SIDE STT)
# ------------------------------------------------------------------------------
# Audio captured from trainee microphones is sent to the server for transcription.
# Supported engines:
#   - 'google'         : Free Google SpeechRecognition API (requires internet / proxy).
#   - 'faster_whisper' : Local whisper model running on the server (pip install faster-whisper).
#   - 'vosk'           : Offline Vosk model on the server (pip install vosk).
STT_ENGINE=google

# Spoken language code.
SPEECH_LANG=en-US
ASSISTANT_SPEECH_LANG=en-US

# Model size for faster-whisper (e.g. tiny, base, small, medium).
ASSISTANT_WHISPER_MODEL=base

# Path to Vosk model folder if using STT_ENGINE=vosk.
# VOSK_MODEL_PATH=data/models/vosk-model-en-us-0.22

# Outbound proxy URL for Google SpeechRecognition (defaults to HTTPS_PROXY env var).
# STT_PROXY=http://proxy.corp.tcs.com:8080

# Additional JSON-encoded keyword arguments passed to the speech recognizer.
# STT_OPTIONS={"model":"base"}


# ------------------------------------------------------------------------------
# 8. KNOWLEDGE BASE & RAG POLICY
# ------------------------------------------------------------------------------
# Storage directory for the ChromaDB vector database.
KB_PATH=data/kb

# Active retrievers (comma-separated). Default is 'kb'.
RAG_RETRIEVERS=kb

# Number of top relevant document passages to inject into the LLM prompt.
RAG_TOP_K=5

# Strict mode: when 1, the model refuses to answer if verified context passages
# are not found in the uploaded policy documents (prevents hallucinations).
RAG_STRICT=1

# Minimum cosine similarity threshold for retrieved knowledge passages (0.0 to 1.0).
KB_MIN_SCORE=0.55

# Maximum allowed file upload size in MB for knowledge base documents.
KB_MAX_FILE_MB=50

# Comma-separated domain hint keywords that route queries to the TCS Ignite space.
KB_IGNITE_HINTS=ignite,smart hiring,trainee,onboarding,induction,ilp,training schedule,assessment,batch,mentor,bootcamp


# ------------------------------------------------------------------------------
# 9. ASSESSMENT & EXAM MODE CONTROLS
# ------------------------------------------------------------------------------
# Emergency campus-wide disable switch. When 1, student assistants are immediately
# disabled during Project Readiness Assessments (PRA) or internal evaluations.
ASSISTANT_BLOCKED=0

# Granular admin capability flags (comma-separated overrides).
# Default capabilities:
# files.read=on, files.create=on, files.copy=on, files.rename=on, files.move=on,
# files.delete=off (destructive), scripts.run=on, system.open=on, system.lock=on,
# clipboard.write=on, kb.ignite=on, kb.general=on
# ASSISTANT_CAPABILITIES="files.delete=off,scripts.run=on"

# Optional path to a JSON file defining per-user policy rules.
# ASSISTANT_POLICY_FILE=data/policy.json

# Custom shortcut links for the deterministic grammar parser (JSON map string).
# ASSISTANT_QUICK_SITES={"ultimatix":"https://auth.ultimatix.net","knome":"https://knome.ultimatix.net"}


# ------------------------------------------------------------------------------
# 10. TRAINEE DESKTOP CLIENT (SRC/CLIENT)
# ------------------------------------------------------------------------------
# WebSocket connection endpoint pointing to the central Ignite Buddy server.
ASSISTANT_URL=ws://127.0.0.1:8765/ws/assistant/

# Local agent HTTP/WebSocket port hosted on the trainee's machine.
ASSISTANT_AGENT_PORT=8777

# Trainee device identifier (defaults to computer hostname if omitted).
# ASSISTANT_DEVICE_ID=DESKTOP-ACCOPS-01

# Global hotkey shortcut to activate / summon the desktop assistant overlay.
ASSISTANT_HOTKEY=ctrl+alt+space

# Desktop shell selection:
#   - 'auto'     : Uses Electron if desktop-electron is built, else PySide6 Qt overlay.
#   - 'pyside6'  : Native Python Qt frameless transparent overlay (ideal for Accops VDI).
#   - 'electron' : Electron BrowserWindow host.
ASSISTANT_SHELL=auto

# Local directory storing trainee notes and task documents (never sent to central server).
# ASSISTANT_HOME=~/Documents/TraineeAssistant

# Folder allowlists for trainee device operations (paths separated by ';' on Windows or ':' on Linux).
# ASSISTANT_SEARCH_ROOTS=Documents;Desktop;Downloads
# ASSISTANT_WRITE_ROOTS=Documents;Desktop
# ASSISTANT_SCRIPT_ROOTS=Documents;Desktop


# ------------------------------------------------------------------------------
# 11. DESKTOP ACTIVITY MONITORING & PRIVACY
# ------------------------------------------------------------------------------
# Interval in seconds between sampling active window titles.
ACTIVITY_INTERVAL=5.0

# Inactivity timeout in seconds before trainee device is marked as IDLE.
ACTIVITY_IDLE_AFTER=120.0

# Comma-separated list of application names to redact/ignore from activity logging.
ACTIVITY_BLOCKLIST=keepass,1password,bitwarden,authenticator,personal

# Retention days for activity events before automatic rolling purge.
RETENTION_DAYS=14

# Pause activity sampling when assistant is blocked in exam mode.
PAUSE_TRACKING_WHEN_BLOCKED=1


# ------------------------------------------------------------------------------
# 12. ADMIN CONSOLE FRONTEND (FRONTEND-ADMIN)
# ------------------------------------------------------------------------------
# Base API URL used by the React Admin Console. In development, Vite proxies /api
# to http://127.0.0.1:8765. In production, configure if backend is hosted separately.
VITE_API_BASE_URL=/api
